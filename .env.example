# WhatsApp Auto-Reply Bot Configuration

# Enable/disable auto-reply (true/false)
AUTO_REPLY_ENABLED=true

# Default message to send when no keyword matches
DEFAULT_MESSAGE=Hello! Thanks for your message. I'll get back to you soon.

# Business hours configuration
BUSINESS_HOURS_ENABLED=false
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00
TIMEZONE=UTC

# Comma-separated list of contact IDs to ignore (optional)
# IGNORE_LIST=1234567890@c.us,0987654321@c.us
